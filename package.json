    "@nestjs/platform-express": "^11.0.0",
    "kafkajs": "^2.2.4",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0"
  },
