{
  "name": "kafka-base-implementation",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "kafka:up": "docker compose up -d",
    "kafka:down": "docker compose down",
    "serve:producer": "nx serve producer-api",
    "serve:consumer": "nx serve consumer-api",
    "serve:apis": "NX_TUI=false nx run-many -t serve -p producer-api consumer-api --parallel=2",
    "serve:dashboard": "next dev apps/dashboard -p ${DASHBOARD_PORT:-4200}",
    "dev": "npm run kafka:up && (npm run serve:apis & npm run serve:dashboard & wait)",
    "test": "nx run-many -t test"
  },
  "private": true,
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
